# Server Configuration
PORT=3000
NODE_ENV=development

# Security
# 64-character random string for signing JWT tokens
JWT_SECRET=c9f8a3e7b1d4c2a5e8f0b3d6a9c1e4f7a2b5d8e1c4f7a0b3d6e9c2a5f8b1d4e7
OTP_MINUTES=10

# Database
DATABASE_FILE=./database/hostel.sqlite

# Real Email Delivery (SMTP)
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-character Google App Password (not your normal password).
# If unconfigured in development, the system falls back safely to console OTP logging so development is never blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Unity Hostel <no-reply@unityhostel.com>
